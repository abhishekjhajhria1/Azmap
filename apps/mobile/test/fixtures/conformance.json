{
  "version": 1,
  "graph": [
    {
      "name": "no edges",
      "rule": "A topic with no prerequisites is available immediately.",
      "topics": [
        {
          "id": "a",
          "progress": "not_started"
        },
        {
          "id": "b",
          "progress": "known"
        }
      ],
      "edges": [],
      "expect": {
        "statuses": {
          "a": "available",
          "b": "known"
        },
        "cycles": [],
        "topo": [
          "a",
          "b"
        ]
      }
    },
    {
      "name": "hard edge gates",
      "rule": "`to` stays locked until every hard prerequisite is known.",
      "topics": [
        {
          "id": "a",
          "progress": "not_started"
        },
        {
          "id": "b",
          "progress": "not_started"
        }
      ],
      "edges": [
        {
          "from": "a",
          "to": "b",
          "strength": "hard"
        }
      ],
      "expect": {
        "statuses": {
          "a": "available",
          "b": "locked"
        },
        "unlockProbe": "a",
        "unlocks": [
          "b"
        ],
        "cycles": [],
        "topo": [
          "a",
          "b"
        ]
      }
    },
    {
      "name": "hard edge satisfied",
      "rule": "Once the prerequisite is known the dependent becomes available.",
      "topics": [
        {
          "id": "a",
          "progress": "known"
        },
        {
          "id": "b",
          "progress": "not_started"
        }
      ],
      "edges": [
        {
          "from": "a",
          "to": "b",
          "strength": "hard"
        }
      ],
      "expect": {
        "statuses": {
          "a": "known",
          "b": "available"
        },
        "cycles": [],
        "topo": [
          "a",
          "b"
        ]
      }
    },
    {
      "name": "soft edge never gates",
      "rule": "Soft edges inform ordering and must NOT lock anything. Treating one as gating shows a topic locked on one device and open on another.",
      "topics": [
        {
          "id": "a",
          "progress": "not_started"
        },
        {
          "id": "b",
          "progress": "not_started"
        }
      ],
      "edges": [
        {
          "from": "a",
          "to": "b",
          "strength": "soft"
        }
      ],
      "expect": {
        "statuses": {
          "a": "available",
          "b": "available"
        },
        "unlockProbe": "a",
        "unlocks": [],
        "cycles": [],
        "topo": [
          "a",
          "b"
        ]
      }
    },
    {
      "name": "mixed prerequisites",
      "rule": "One unmet hard prerequisite is enough to lock, regardless of soft ones.",
      "topics": [
        {
          "id": "a",
          "progress": "known"
        },
        {
          "id": "b",
          "progress": "not_started"
        },
        {
          "id": "c",
          "progress": "not_started"
        }
      ],
      "edges": [
        {
          "from": "a",
          "to": "c",
          "strength": "hard"
        },
        {
          "from": "b",
          "to": "c",
          "strength": "hard"
        },
        {
          "from": "a",
          "to": "b",
          "strength": "soft"
        }
      ],
      "expect": {
        "statuses": {
          "a": "known",
          "b": "available",
          "c": "locked"
        },
        "unlockProbe": "b",
        "unlocks": [
          "c"
        ],
        "cycles": [],
        "topo": [
          "a",
          "b",
          "c"
        ]
      }
    },
    {
      "name": "diamond",
      "rule": "Completing the root unlocks only what becomes *newly* available — the join node stays locked because its other branch is still unknown.",
      "topics": [
        {
          "id": "root",
          "progress": "not_started"
        },
        {
          "id": "left",
          "progress": "not_started"
        },
        {
          "id": "right",
          "progress": "not_started"
        },
        {
          "id": "join",
          "progress": "not_started"
        }
      ],
      "edges": [
        {
          "from": "root",
          "to": "left",
          "strength": "hard"
        },
        {
          "from": "root",
          "to": "right",
          "strength": "hard"
        },
        {
          "from": "left",
          "to": "join",
          "strength": "hard"
        },
        {
          "from": "right",
          "to": "join",
          "strength": "hard"
        }
      ],
      "expect": {
        "statuses": {
          "root": "available",
          "left": "locked",
          "right": "locked",
          "join": "locked"
        },
        "unlockProbe": "root",
        "unlocks": [
          "left",
          "right"
        ],
        "cycles": [
          {
            "from": "join",
            "to": "root",
            "cyclic": true
          },
          {
            "from": "root",
            "to": "join",
            "cyclic": false
          }
        ],
        "topo": [
          "root",
          "left",
          "right",
          "join"
        ]
      }
    },
    {
      "name": "known topic is never available",
      "rule": "`known` outranks `available`; a finished topic is not offered again.",
      "topics": [
        {
          "id": "a",
          "progress": "known"
        },
        {
          "id": "b",
          "progress": "in_progress"
        }
      ],
      "edges": [],
      "expect": {
        "statuses": {
          "a": "known",
          "b": "in_progress"
        },
        "cycles": [],
        "topo": [
          "a",
          "b"
        ]
      }
    },
    {
      "name": "chain",
      "rule": "Ordering is transitive: the tail is locked until the whole chain is done.",
      "topics": [
        {
          "id": "a",
          "progress": "known"
        },
        {
          "id": "b",
          "progress": "not_started"
        },
        {
          "id": "c",
          "progress": "not_started"
        },
        {
          "id": "d",
          "progress": "not_started"
        }
      ],
      "edges": [
        {
          "from": "a",
          "to": "b",
          "strength": "hard"
        },
        {
          "from": "b",
          "to": "c",
          "strength": "hard"
        },
        {
          "from": "c",
          "to": "d",
          "strength": "hard"
        }
      ],
      "expect": {
        "statuses": {
          "a": "known",
          "b": "available",
          "c": "locked",
          "d": "locked"
        },
        "unlockProbe": "b",
        "unlocks": [
          "c"
        ],
        "cycles": [
          {
            "from": "d",
            "to": "a",
            "cyclic": true
          }
        ],
        "topo": [
          "a",
          "b",
          "c",
          "d"
        ]
      }
    },
    {
      "name": "dangling edge is ignored",
      "rule": "An edge pointing at a topic that isn't in the set must not gate anything — sync can deliver an edge before the topic it references.",
      "topics": [
        {
          "id": "a",
          "progress": "not_started"
        }
      ],
      "edges": [
        {
          "from": "ghost",
          "to": "a",
          "strength": "hard"
        }
      ],
      "expect": {
        "statuses": {
          "a": "available"
        },
        "cycles": [],
        "topo": [
          "a"
        ]
      }
    },
    {
      "name": "cycle",
      "rule": "A cyclic graph has no teaching order; `topoOrder` returns null rather than an arbitrary one.",
      "topics": [
        {
          "id": "a",
          "progress": "not_started"
        },
        {
          "id": "b",
          "progress": "not_started"
        }
      ],
      "edges": [
        {
          "from": "a",
          "to": "b",
          "strength": "hard"
        },
        {
          "from": "b",
          "to": "a",
          "strength": "hard"
        }
      ],
      "expect": {
        "statuses": {
          "a": "locked",
          "b": "locked"
        },
        "cycles": [
          {
            "from": "a",
            "to": "a",
            "cyclic": true
          }
        ],
        "topo": null
      }
    }
  ],
  "order": [
    {
      "name": "rev wins",
      "rule": "Higher rev always wins, whatever the clocks say.",
      "a": {
        "id": "x",
        "rev": 2,
        "updatedAt": 1,
        "deviceId": "z"
      },
      "b": {
        "id": "x",
        "rev": 1,
        "updatedAt": 999,
        "deviceId": "a"
      },
      "expect": 1
    },
    {
      "name": "updatedAt breaks equal rev",
      "rule": "Same rev → newer updatedAt wins.",
      "a": {
        "id": "x",
        "rev": 1,
        "updatedAt": 5,
        "deviceId": "z"
      },
      "b": {
        "id": "x",
        "rev": 1,
        "updatedAt": 9,
        "deviceId": "a"
      },
      "expect": -1
    },
    {
      "name": "deviceId breaks the tie",
      "rule": "Same rev and same millisecond → lexicographic deviceId. Arbitrary, but *stable*: both peers must pick the same side or they never converge.",
      "a": {
        "id": "x",
        "rev": 1,
        "updatedAt": 5,
        "deviceId": "aaa"
      },
      "b": {
        "id": "x",
        "rev": 1,
        "updatedAt": 5,
        "deviceId": "bbb"
      },
      "expect": -1
    },
    {
      "name": "identical",
      "rule": "Fully equal versions compare equal.",
      "a": {
        "id": "x",
        "rev": 1,
        "updatedAt": 5,
        "deviceId": "a"
      },
      "b": {
        "id": "x",
        "rev": 1,
        "updatedAt": 5,
        "deviceId": "a"
      },
      "expect": 0
    },
    {
      "name": "missing fields are zero and empty",
      "rule": "An absent updatedAt/deviceId must behave as 0 / \"\", not as undefined.",
      "a": {
        "id": "x",
        "rev": 1
      },
      "b": {
        "id": "x",
        "rev": 1,
        "updatedAt": 0,
        "deviceId": ""
      },
      "expect": 0
    },
    {
      "name": "rev zero",
      "rule": "rev 0 is a real revision, not a missing one.",
      "a": {
        "id": "x",
        "rev": 0,
        "updatedAt": 10,
        "deviceId": "b"
      },
      "b": {
        "id": "x",
        "rev": 0,
        "updatedAt": 10,
        "deviceId": "a"
      },
      "expect": 1
    }
  ],
  "tombstone": [
    {
      "name": "delete beats an older edit",
      "rule": "A tombstone newer than the record removes it.",
      "record": {
        "id": "x",
        "rev": 1,
        "updatedAt": 5,
        "deviceId": "a"
      },
      "tomb": {
        "id": "x",
        "collection": "topics",
        "rev": 2,
        "deletedAt": 9,
        "deviceId": "b"
      },
      "expect": true
    },
    {
      "name": "edit beats an older delete",
      "rule": "An edit made after a delete resurrects nothing — but a *newer* edit must win, or a stale delete silently eats live work.",
      "record": {
        "id": "x",
        "rev": 3,
        "updatedAt": 20,
        "deviceId": "a"
      },
      "tomb": {
        "id": "x",
        "collection": "topics",
        "rev": 2,
        "deletedAt": 9,
        "deviceId": "b"
      },
      "expect": false
    },
    {
      "name": "unknown record",
      "rule": "A tombstone for something we've never seen still applies.",
      "record": null,
      "tomb": {
        "id": "x",
        "collection": "topics",
        "rev": 1,
        "deletedAt": 1,
        "deviceId": "a"
      },
      "expect": true
    },
    {
      "name": "same rev and time, deviceId decides",
      "rule": "The tie-break is the same total order used everywhere else.",
      "record": {
        "id": "x",
        "rev": 1,
        "updatedAt": 5,
        "deviceId": "aaa"
      },
      "tomb": {
        "id": "x",
        "collection": "topics",
        "rev": 1,
        "deletedAt": 5,
        "deviceId": "bbb"
      },
      "expect": true
    }
  ]
}
