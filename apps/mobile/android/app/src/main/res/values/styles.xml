<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown from tap to Flutter's first frame. Painted with ABH's own light
         background (#FBFBFD from theme.css), not white: the gap is ~200ms on a
         mid-range phone, and a white flash before a near-white app is the most
         visible way to look unfinished. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Takes over once Flutter is drawing. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
