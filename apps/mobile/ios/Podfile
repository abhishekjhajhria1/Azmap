# ABH targets iOS 13. sqlite3_flutter_libs and the cryptography package both
# want 12+, and Flutter's own floor is 12 — 13 buys `@available` cleanliness
# for a version share that rounds to zero in 2026.
platform :ios, '13.0'

# Speeds up CocoaPods and stops it printing a wall of warnings about a stats
# endpoint nobody reads.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. Run `flutter pub get` in apps/mobile first."
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in Generated.xcconfig. Try deleting it and running `flutter pub get`."
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # The share extension shares the plugin pods with the app so both sides can
  # reach the App Group container. Uncomment after adding the target in Xcode
  # — see lib/capture/PLATFORM_SETUP.md.
  # target 'Share Extension' do
  #   inherit! :search_paths
  # end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # Pods default to iOS 12 and warn on every build; pinning them to the
      # app's floor silences a hundred lines of noise that hides real warnings.
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
    end
  end
end
